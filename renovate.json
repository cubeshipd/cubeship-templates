{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^[a-z0-9-]+\\/template\\.yaml$/"],
      "matchStrings": ["image:[ \\t]+(?<depName>[^\\s#]+)[\\s\\S]*?tag:[ \\t]+[\"']?(?<currentValue>[^\\s\"'#]+)"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^[a-z0-9-]+\\/template\\.yaml$/"],
      "matchStrings": ["repo:[ \\t]+https://github\\.com/(?<depName>[^\\s#]+)[\\s\\S]*?ref:[ \\t]+[\"']?(?<currentValue>[^\\s\"'#]+)"],
      "datasourceTemplate": "github-tags"
    }
  ]
}
